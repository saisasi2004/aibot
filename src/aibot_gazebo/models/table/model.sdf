<?xml version="1.0"?>
<!-- Static table. Model origin is on the floor under the centre of the top.
     Top 0.30 (x) x 0.68 (y) m, surface at z = 0.98 m (slab 0.03 m thick, legs 0.95 m).

     Height: the robot's shoulders are at z = 1.33 m and its arm (shoulder -> wrist) is only 0.40 m,
     so a palm-down grasp on a 0.85 m table is out of reach; at 0.98 m (robot elbow height,
     like a workbench) the wrist needs 0.32-0.38 m.

     Wide enough for all 11 objects, and starting at x = 0.36 so the hanging arms have room to
     rise in front of it: they sit at y = +-0.245 m with fingertips at z ~ 0.62 m, inside the
     table's width. A low straight-arm swing in mimic stops at the near edge, like at a real
     bench; raise the forearm above the top to reach over it. -->
<sdf version="1.9">
  <model name="table">
    <static>true</static>
    <link name="link">
      <collision name="top_collision">
        <pose>0 0 0.965 0 0 0</pose>
        <geometry><box><size>0.30 0.68 0.03</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="top_visual">
        <pose>0 0 0.965 0 0 0</pose>
        <geometry><box><size>0.30 0.68 0.03</size></box></geometry>
        <material>
          <ambient>0.45 0.32 0.20 1</ambient>
          <diffuse>0.55 0.40 0.25 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- legs: 0.02 m radius, inset 0.03 m from the corners -->
      <collision name="leg_fl_collision">
        <pose>0.12 0.31 0.475 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.95</length></cylinder></geometry>
      </collision>
      <visual name="leg_fl_visual">
        <pose>0.12 0.31 0.475 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.95</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <collision name="leg_fr_collision">
        <pose>0.12 -0.31 0.475 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.95</length></cylinder></geometry>
      </collision>
      <visual name="leg_fr_visual">
        <pose>0.12 -0.31 0.475 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.95</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <collision name="leg_bl_collision">
        <pose>-0.12 0.31 0.475 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.95</length></cylinder></geometry>
      </collision>
      <visual name="leg_bl_visual">
        <pose>-0.12 0.31 0.475 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.95</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <collision name="leg_br_collision">
        <pose>-0.12 -0.31 0.475 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.95</length></cylinder></geometry>
      </collision>
      <visual name="leg_br_visual">
        <pose>-0.12 -0.31 0.475 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.95</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
