<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aibot_bringup</name>
  <version>0.1.0</version>
  <description>One-command launch of webcam teleop: Gazebo, controllers, webcam GUI, retargeting, grasping, RViz.</description>
  <maintainer email="gampassv2004@gmail.com">Gampa Sai Sasivardhan</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>aibot_description</exec_depend>
  <exec_depend>aibot_gazebo</exec_depend>
  <exec_depend>aibot_teleop</exec_depend>
  <exec_depend>aibot_ai</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
