<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aibot_description</name>
  <version>0.1.0</version>
  <description>
    RobotEra STAR1 humanoid (github.com/roboterax/models) prepared for fixed-base upper-body
    teleoperation: re-rooted at the pelvis, legs locked upright, convex-hull collisions,
    ros2_control and Gazebo Harmonic tags.
  </description>
  <maintainer email="gampassv2004@gmail.com">Gampa Sai Sasivardhan</maintainer>
  <license>BSD-3-Clause</license>
  <author>RobotEra (STAR1 model and meshes)</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
