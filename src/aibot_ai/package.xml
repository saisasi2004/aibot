<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aibot_ai</name>
  <version>0.1.0</version>
  <description>
    Physical AI mode for STAR1: mode manager (mimic/AI hand-over), head-camera perception,
    skill server (IK + minimum-jerk motion), and a local LLM/VLM planner via Ollama.
    Python dependencies beyond ROS are in requirements-ai.txt (installed into ~/aibot/.venv).
  </description>
  <maintainer email="gampassv2004@gmail.com">Gampa Sai Sasivardhan</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>aibot_msgs</exec_depend>
  <exec_depend>aibot_teleop</exec_depend>
  <exec_depend>aibot_description</exec_depend>
  <exec_depend>aibot_gazebo</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
